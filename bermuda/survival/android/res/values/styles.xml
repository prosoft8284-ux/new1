<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The WebView paints its first frame late on old hardware. A dark window
         background means the launch is a fade from near-black instead of a
         white flash, which is the first thing a player notices. -->
    <style name="GameTheme" parent="@android:style/Theme.NoTitleBar.Fullscreen">
        <item name="android:windowBackground">@color/boot</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowActionBar">false</item>
    </style>
</resources>
